   "source": [
    "def binary_search(nums, target):\n",
    "    l,r = 0, len(nums)-1\n",
    "    \n",
    "    while l < r:\n",
    "        mid = (l-r)//2\n",
    "        if nums[mid] ==  target:\n",
    "            return mid\n",
    "        elif nums[l] < target:\n",
    "            l = mid+1\n",
    "        else:\n",
    "            r = mid-1\n",
    "    \n",
    "    return -1\n",
    "    \n",
    "        "
   ]
  }
