   "source": [
    "def move_zeros(nums):\n",
    "    left = 0\n",
    "    \n",
    "    for right in range(len(nums)):\n",
    "        if nums[right] != 0:\n",
    "            nums[left], nums[right] = nums[right], nums[left]\n",
    "            left +=1 \n",
    "    \n",
    "    return nums\n",
    "\n",
    "\n",
    "move_zeros([0, 1, 0, 3, 12])"
   ]
  }
 ],
