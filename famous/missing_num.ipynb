   "source": [
    "Given an array nums containing n distinct numbers in the range [0, n], return the only number in the range that is missing."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9f9f6c01",
   "metadata": {},
   "outputs": [],
   "source": [
    "def missing_num(nums):\n",
    "    n = len(nums)\n",
    "    \n",
    "    expected = n*(n+1)//2\n",
    "    actual = sum(nums)\n",
    "    return expected - actual"
   ]
  }
